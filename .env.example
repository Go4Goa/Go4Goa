NODE_ENV=development
GO_GOA_DEMO=true
PUBLIC_ORIGIN=http://127.0.0.1:4310
PORT=4311
DATABASE_URL=postgresql://go_goa:go_goa_local_only@127.0.0.1:5433/go_goa
TEST_DATABASE_URL=postgresql://go_goa:go_goa_local_only@127.0.0.1:5433/go_goa_test
# Production: generate a dedicated 32-byte hex key. Never reuse another project's secrets.
# DATA_KEY=
# USE_POSTGIS=true
# Enable phone sign-in only after all three Twilio Verify values are present.
# GO_GOA_PHONE_VERIFICATION=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_MESSAGING_SERVICE_SID=
# RESEND_API_KEY=
# RESEND_FROM=
# RESEND_WEBHOOK_SECRET=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MAPTILER_KEY=

# Dedicated hosted QA project only; values belong in the host secret manager.
# GO_GOA_QA=true
# QA_ACCESS_CODE=
# BLOB_READ_WRITE_TOKEN=
