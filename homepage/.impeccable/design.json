    },
    {
      "name": "Resource card",
      "kind": "card",
      "refersTo": "resource-card",
      "description": "A practical next-step preview with quiet row dividers and an onward link.",
      "html": "<article class=\"ds-resource\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 7v14M3 3h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5v18h-5a4 4 0 0 0-4 0 4 4 0 0 0-4 0H3V3Z\"/></svg><h3>A next step,<br>closer to home.</h3><div class=\"ds-resource-rows\"><div>Separate your waste</div><div>Find collection guidance</div><div>Organize a cleanup</div></div><p>Guidance and source-backed resources from ActForGoa.</p><a href=\"https://actforgoa.org\">Explore ActForGoa<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></a></article>",
      "css": ".ds-resource{font-family:\"Inter Variable\",Inter,sans-serif;font-style:normal;padding:30px;color:var(--green,#193e32);width:100%;max-width:450px;background:#fafcf6;border-radius:20px;}.ds-resource>svg{width:34px;height:34px;}.ds-resource h3{font-size:38px;line-height:1.05;letter-spacing:-.045em;font-weight:450;margin:22px 0 0;}.ds-resource-rows{margin-top:20px;}.ds-resource-rows>div{padding:15px 0;border-bottom:1px solid #dce5d7;font-size:13px;}.ds-resource p{font-size:13px;line-height:1.5;color:#60705c;margin:20px 0;}.ds-resource a{display:flex;align-items:center;gap:15px;font-size:13px;min-height:38px;color:inherit;text-decoration:none;}.ds-resource a:focus-visible{outline:3px solid #44875a;outline-offset:5px;}"
    },
    {
      "name": "Feature accordion row",
      "kind": "custom",
      "refersTo": "feature-accordion",
      "description": "A large active word, explanatory copy, and a structural divider.",
