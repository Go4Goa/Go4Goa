    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Rounded call to action with an outline arrow, hover lift, and visible keyboard focus.",
      "html": "<a class=\"ds-button-primary\" href=\"#explore\">Explore the app<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></a>",
      "css": ".ds-button-primary{font-family:\"Inter Variable\",Inter,sans-serif;font-style:normal;display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:58px;padding:0 26px;border:0;border-radius:17px;font-size:16px;font-weight:400;letter-spacing:-.02em;text-decoration:none;cursor:pointer;transition:background .2s,transform .25s;background:#17221b;color:#fff;}.ds-button-primary:hover{background:#2b4b37;transform:translateY(-2px);}.ds-button-primary:focus-visible{outline:3px solid #44875a;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Light action",
      "kind": "button",
      "refersTo": "button-light",
      "description": "Rounded call to action with an outline arrow, hover lift, and visible keyboard focus.",
      "html": "<a class=\"ds-button-light\" href=\"#explore\">Explore the app<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></a>",
      "css": ".ds-button-light{font-family:\"Inter Variable\",Inter,sans-serif;font-style:normal;display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:58px;padding:0 26px;border:0;border-radius:17px;font-size:16px;font-weight:400;letter-spacing:-.02em;text-decoration:none;cursor:pointer;transition:background .2s,transform .25s;background:#f4f6ef;color:var(--ink,#141815);}.ds-button-light:hover{background:#e6f4cf;transform:translateY(-2px);}.ds-button-light:focus-visible{outline:3px solid #44875a;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-button-light{transition:none;}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "text-action",
      "description": "An unboxed link whose arrow moves on hover.",
      "html": "<a class=\"ds-text-action\" href=\"#explore\">Explore the app<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></a>",
      "css": ".ds-text-action{font-family:\"Inter Variable\",Inter,sans-serif;font-style:normal;display:inline-flex;align-items:center;gap:24px;min-height:44px;font-size:16px;letter-spacing:-.02em;color:var(--ink,#141815);text-decoration:none;}.ds-text-action svg{transition:transform .3s var(--ease,cubic-bezier(.16,1,.3,1));}.ds-text-action:hover svg{transform:translate(3px,-3px);}.ds-text-action:focus-visible{outline:3px solid #44875a;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-text-action svg{transition:none;}}"
    },
    {
      "name": "Navigation capsule",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Identity, links, and a menu trigger on one light floating surface.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-brand\" href=\"#top\">go4goa<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></a><div class=\"ds-nav-links\"><a href=\"#explore\">The app</a><a href=\"#document\">Document</a><a href=\"#meetups\">Meetups</a><a href=\"#resources\">Resources</a></div><button class=\"ds-menu\" aria-label=\"Open menu\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button></nav>",
      "css": ".ds-nav{font-family:\"Inter Variable\",Inter,sans-serif;font-style:normal;display:inline-flex;align-items:center;gap:38px;background:#f0f1eefa;backdrop-filter:blur(16px);padding:14px 20px;border-radius:22px;min-height:68px;color:var(--ink,#141815);}.ds-nav a{color:inherit;text-decoration:none;}.ds-brand{display:inline-flex;align-items:center;gap:3px;font-size:30px;font-weight:760;letter-spacing:-.065em;line-height:1;white-space:nowrap;}.ds-brand svg{width:24px;height:24px;}.ds-nav-links{display:flex;gap:23px;}.ds-nav-links a{font-size:14px;white-space:nowrap;transition:color .2s;}.ds-nav-links a:hover{color:#38734b;}.ds-menu{width:28px;height:34px;border:0;background:transparent;display:grid;place-items:center;padding:0;color:inherit;cursor:pointer;}.ds-nav a:focus-visible,.ds-menu:focus-visible{outline:3px solid #44875a;outline-offset:5px;}@media(max-width:899px){.ds-nav-links{display:none;}.ds-nav{gap:35px;padding:16px 18px;min-height:62px;}.ds-brand{font-size:27px;}}"
    },
    {
      "name": "Product tabs",
      "kind": "nav",
      "refersTo": "product-tab-selected",
      "description": "The selected feature is a pale green tab with a matching outline icon.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Explore app features\"><button role=\"tab\" aria-selected=\"true\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6ZM9 3v15M15 6v15\"/></svg><span>Map</span></button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 7v14M3 3h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5v18h-5a4 4 0 0 0-4 0 4 4 0 0 0-4 0H3V3Z\"/></svg><span>Resources</span></button></div>",
      "css": ".ds-tabs{display:flex;align-items:center;gap:6px;}.ds-tabs button{font-family:\"Inter Variable\",Inter,sans-serif;font-style:normal;display:flex;align-items:center;gap:8px;padding:10px 14px;min-height:42px;border:0;border-radius:11px;background:transparent;font-size:13px;color:#67756b;cursor:pointer;}.ds-tabs button[aria-selected=\"true\"]{background:#eaf0e7;color:#1b4b31;}.ds-tabs button:focus-visible{outline:3px solid #44875a;outline-offset:5px;}"
    },
