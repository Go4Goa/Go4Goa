  "narrative": {
    "northStar": "The local keychain",
    "overview": "A glossy object opens into a calm, spacious civic world. Oversized upright grotesk type, a neutral gray-to-paper ground, forest-green controls, and real Goa photography make the page direct, warm, and tactile. Color sits in the artwork, product tiles, and selected controls; the surrounding page gives those elements room.\n\nThis system describes the finished standalone homepage in homepage/, for Goa residents and local communities. It records the actual CSS and components, informed by the pinned Butter reference and the direction in docs/PLAN.md. The operational app has its own design system in the repository root; these marketing rules do not replace it.",
    "keyCharacteristics": [
      "Oversized upright type with tight tracking and short, balanced lines.",
      "Long quiet intervals around photography, product previews, and a single measured icon handoff.",
      "Neutral page ground with forest-green actions and restrained lime, coral, and silver accents.",
      "Rounded controls and softly lifted previews; flat solid-color secondary icon tiles.",
      "Visible example labels, keyboard focus, and a complete static reading path when motion is reduced."
    ],
    "rules": [
      {
        "name": "The quiet ground Rule",
        "body": "Keep the page ground neutral. Let the artwork and product states carry the brighter colors.",
        "section": "colors"
      },
      {
        "name": "The upright voice Rule",
        "body": "Use upright type throughout. Emphasis comes from scale, weight, spacing, and color.",
        "section": "typography"
      },
      {
        "name": "The measured handoff Rule",
        "body": "When an object becomes a control, measure the actual source and destination, refresh those measurements after layout changes, and reveal the destination only after arrival.",
        "section": "layout"
      },
      {
        "name": "The material boundary Rule",
        "body": "Keep gloss in the authored hero image. Secondary icon tiles use solid fills and soft offset shadows, without simulated bevels or inset highlights.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the neutral ground, upright type, and generous spacing of this standalone marketing surface.",
      "Do keep the actual outline SVG icons consistent between a moving tile and its destination control.",
      "Do label fictional interactive examples and historical photography where they appear.",
      "Do provide visible keyboard focus and preserve all content when scroll motion is removed.",
      "Do collapse the desktop choreography into the existing responsive reading order on narrow screens."
    ],
    "donts": [
      "Don't use italic or oblique type, including wordmarks and artwork text.",
      "Don't use decorative accent stripes along the side of any card, alert, quote, or container.",
      "Don't add eyebrow labels, fabricated impact metrics, partner endorsements, or live-event claims.",
      "Don't turn the hero's glossy material into beveled secondary controls.",
      "Don't inherit the demo's smallest caption sizes as a general text scale or apply this homepage system to the operational app."
