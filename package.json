{
  "name": "go-goa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --import tsx --env-file-if-exists=.env server/index.ts",
    "db:setup": "node --import tsx --env-file-if-exists=.env scripts/setup.ts",
    "db:seed": "node --import tsx --env-file-if-exists=.env scripts/seed.ts",
    "sync": "node --import tsx --env-file-if-exists=.env scripts/sync.ts",
    "worker": "node --import tsx --env-file-if-exists=.env server/worker.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --env-file-if-exists=.env --test tests/*.test.ts",
    "build": "npm run build:app && npm run build:homepage && node scripts/assemble-homepage.mjs",
    "build:app": "npm run check && vite build",
    "build:homepage": "npm ci --prefix homepage --ignore-scripts && npm run build --prefix homepage",
    "start": "node --import tsx --env-file-if-exists=.env server/index.ts",
    "test:integration": "node --import tsx --env-file-if-exists=.env scripts/test-integration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.3.7",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.4",
    "cookie-parser": "^1.4.7",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.6.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "supercluster": "^8.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.58.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.2.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
